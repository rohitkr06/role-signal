# Optional discovery connectors. RoleSignal still runs with Freehire, Remotive,
# Jobicy, Arbeitnow, connected company boards, and pasted portal alerts when blank.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_API_KEY=

# Required only for automated email-forwarding into /api/rolesignal/inbound-email.
INBOUND_EMAIL_SECRET=

# Optional for self-hosting. Railway users should attach a volume and normally
# leave this blank; RAILWAY_VOLUME_MOUNT_PATH is detected automatically.
ROLESIGNAL_DATA_DIR=
